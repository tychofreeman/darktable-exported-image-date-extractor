# Sourced by the other bin/ scripts: sets $jar to the java-refactor-mcp release jar
# (https://github.com/tychofreeman/java-refactor-mcp/releases), and JAVA_HOME to the
# JDK javac belongs to when it is unset (the default java may be a runtime only).
# Override the jar's location with JREFACTOR_JAR.
jar=${JREFACTOR_JAR:-$HOME/.local/share/java-refactor-mcp/java-refactor-mcp.jar}
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVA_HOME=$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")
  export JAVA_HOME
fi
