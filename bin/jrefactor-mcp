#!/bin/sh
# Starts the java-refactor-mcp server serving the project given as $1 (default:
# this project), with the jar bin/jrefactor-env locates. Stdout carries the MCP
# protocol, so messages go to stderr.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
root=${1:-$here}
. "$here/bin/jrefactor-env"
[ -f "$jar" ] || { echo "jrefactor-mcp: no jar at $jar (set JREFACTOR_JAR)" >&2; exit 1; }
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -jar "$jar" "$root"
