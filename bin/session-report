#!/bin/sh
# Reports on a session log (bin/session-log): what went through java-refactor-mcp, what
# was done by hand, after a refusal, in large writes, and what was read. With no
# arguments, the log of the branch checked out. The whats-next skill puts it in the
# item's session record.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
. "$here/bin/jrefactor-env"
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -cp "$jar" \
  io.github.tychofreeman.jrefactor.SessionReport "$@"
